/* =========================================================
   AGATA PROXIMA — AUTHENTICATION
   Complete authentication layout
   ========================================================= */

.auth-page {
  min-height: 100vh;
  width: 100%;
  background: #f7f8fa;
  color: #101828;
  overflow-x: hidden;
}

.auth-shell {
  min-height: 100vh;
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(520px, 0.78fr);
}

/* =========================================================
   LEFT PRODUCT PANEL
   ========================================================= */

.auth-brand-panel {
  min-width: 0;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 32px 56px 28px;
  background: #080b1d;
  color: #ffffff;
  overflow: hidden;
}

.auth-brand-panel::before {
  content: "";
  position: absolute;
  width: 620px;
  height: 620px;
  left: -280px;
  bottom: -300px;
  border: 1px solid rgba(77, 141, 255, 0.18);
  border-radius: 50%;
  pointer-events: none;
}

.auth-brand-panel::after {
  content: "";
  position: absolute;
  width: 460px;
  height: 460px;
  right: -230px;
  bottom: -250px;
  border: 1px solid rgba(77, 141, 255, 0.12);
  border-radius: 50%;
  pointer-events: none;
}

.auth-brand {
  position: relative;
  z-index: 2;
  display: inline-flex;
  width: fit-content;
  align-items: center;
  text-decoration: none;
}

.auth-brand-panel .auth-brand svg {
  display: block;
}

.auth-hero {
  position: relative;
  z-index: 2;
  width: min(100%, 720px);
  margin: auto 0;
  padding: 64px 0;
}

.auth-hero h1 {
  max-width: 650px;
  margin: 0;
  font-size: clamp(42px, 4.4vw, 68px);
  line-height: 0.98;
  letter-spacing: -0.055em;
  font-weight: 750;
}

.auth-hero p {
  max-width: 620px;
  margin: 24px 0 0;
  color: rgba(255, 255, 255, 0.68);
  font-size: 15px;
  line-height: 1.75;
}

.auth-product-visual {
  position: relative;
  z-index: 2;
  width: min(100%, 520px);
  margin-top: 38px;
  padding: 12px;
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.035);
}

.auth-product-visual-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.auth-product-node {
  min-width: 0;
  padding: 18px;
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.045);
}

.auth-product-node strong {
  display: block;
  color: #ffffff;
  font-size: 13px;
  line-height: 1.3;
}

.auth-product-node span {
  display: block;
  margin-top: 7px;
  color: rgba(255, 255, 255, 0.48);
  font-size: 11px;
  line-height: 1.4;
}

.auth-footer {
  position: relative;
  z-index: 2;
  color: rgba(255, 255, 255, 0.38);
  font-size: 11px;
}

/* =========================================================
   RIGHT AUTH PANEL
   ========================================================= */

.auth-panel {
  width: 100%;
  min-width: 0;
  min-height: 100vh;
  box-sizing: border-box;

  display: flex;
  flex-direction: column;
  justify-content: center;

  padding: 48px clamp(40px, 6vw, 96px);

  background: #f7f8fa;
}

.auth-panel-inner {
  width: 100%;
  max-width: 440px;
  margin: 0 auto;
}

/* Some versions of AuthLayout place the contents
   directly inside .auth-panel. */
.auth-panel > * {
  max-width: 440px;
}

.auth-heading {
  width: 100%;
  margin-bottom: 32px;
}

.auth-heading h1 {
  margin: 0;
  color: #101828;
  font-size: 34px;
  line-height: 1.08;
  letter-spacing: -0.035em;
  font-weight: 720;
}

.auth-heading p {
  margin: 12px 0 0;
  color: #667085;
  font-size: 14px;
  line-height: 1.65;
}

/* =========================================================
   FORM
   ========================================================= */

.auth-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.auth-form label {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 8px;

  color: #344054;
  font-size: 13px;
  line-height: 1.4;
  font-weight: 600;
}

.auth-form input {
  width: 100%;
  height: 48px;
  box-sizing: border-box;

  padding: 0 14px;

  border: 1px solid #d0d5dd;
  border-radius: 8px;

  background: #ffffff;
  color: #101828;

  font: inherit;
  font-size: 14px;

  outline: none;

  transition:
    border-color 140ms ease,
    box-shadow 140ms ease;
}

.auth-form input::placeholder {
  color: #98a2b3;
}

.auth-form input:hover {
  border-color: #b8c0cc;
}

.auth-form input:focus {
  border-color: #176bff;
  box-shadow: 0 0 0 3px rgba(23, 107, 255, 0.12);
}

.auth-submit {
  width: 100%;
  min-height: 48px;
  margin-top: 4px;
}

.auth-form button:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

.auth-error {
  width: 100%;
  box-sizing: border-box;

  padding: 12px 14px;

  border: 1px solid rgba(240, 68, 56, 0.22);
  border-radius: 8px;

  background: rgba(240, 68, 56, 0.06);
  color: #b42318;

  font-size: 13px;
  line-height: 1.5;
}

/* =========================================================
   SECONDARY LINKS
   ========================================================= */

.auth-links {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12px;

  margin-top: 28px;

  color: #667085;
  font-size: 13px;
  line-height: 1.5;
}

.auth-links a {
  color: #176bff;
  font-weight: 600;
  text-decoration: none;
}

.auth-links a:hover {
  text-decoration: underline;
}

.auth-links span {
  color: #667085;
}

/* =========================================================
   BUTTON FALLBACK
   ========================================================= */

.auth-panel .button {
  border: 0;
  border-radius: 8px;
  font: inherit;
  font-weight: 650;
  cursor: pointer;
}

.auth-panel .button-primary {
  background: #176bff;
  color: #ffffff;
}

.auth-panel .button-primary:hover:not(:disabled) {
  background: #0f5de0;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1100px) {
  .auth-shell {
    grid-template-columns: minmax(0, 1fr) minmax(460px, 0.8fr);
  }

  .auth-brand-panel {
    padding-inline: 40px;
  }

  .auth-panel {
    padding-inline: 48px;
  }
}

@media (max-width: 900px) {
  .auth-shell {
    grid-template-columns: 1fr;
  }

  .auth-brand-panel {
    min-height: auto;
    padding: 28px 32px;
  }

  .auth-hero {
    padding: 64px 0;
  }

  .auth-panel {
    min-height: auto;
    padding: 56px 32px 64px;
  }

  .auth-panel > * {
    width: min(100%, 440px);
    max-width: 440px;
    margin-inline: auto;
  }
}

@media (max-width: 560px) {
  .auth-brand-panel {
    padding: 24px;
  }

  .auth-hero {
    padding: 48px 0;
  }

  .auth-hero h1 {
    font-size: 40px;
  }

  .auth-product-visual-inner {
    grid-template-columns: 1fr;
  }

  .auth-panel {
    padding: 40px 24px 48px;
  }

  .auth-heading h1 {
    font-size: 30px;
  }
}
