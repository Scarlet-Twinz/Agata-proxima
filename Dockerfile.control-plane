FROM rust:1-bookworm AS builder

WORKDIR /app
COPY . .
RUN cargo build --release -p proxima-control-plane

FROM debian:bookworm-slim
RUN useradd --create-home --uid 10002 proxima && mkdir -p /var/lib/proxima && chown -R proxima:proxima /var/lib/proxima
COPY --from=builder /app/target/release/proxima-control-plane /usr/local/bin/proxima-control-plane
USER proxima
EXPOSE 9090
ENV PROXIMA_CONTROL_PLANE_LISTEN_ADDR=0.0.0.0:9090
ENV PROXIMA_CONTROL_PLANE_STATE=/var/lib/proxima/control-plane.json
ENTRYPOINT ["/usr/local/bin/proxima-control-plane"]
