{
  "openapi": "3.1.0",
  "info": {
    "title": "Agata Proxima Control Plane API",
    "version": "0.2.0",
    "description": "Authenticated management plane for organizations, tenants, policies, fleet and secure node enrollment, deployments, verification, signed attestations, audit, support and Flutterwave billing. The Proxima Engine remains the independent data-plane enforcement authority."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Control plane healthy"
          },
          "503": {
            "description": "Control plane degraded"
          }
        }
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "security": [],
        "responses": {
          "200": {
            "description": "Workspace created and session established"
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "Identity already exists"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "security": [],
        "responses": {
          "200": {
            "description": "Session established"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "responses": {
          "200": {
            "description": "Session revoked"
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "responses": {
          "200": {
            "description": "Current session"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/v1/platform/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Organization platform status"
          }
        }
      }
    },
    "/api/v1/organizations": {
      "get": {
        "responses": {
          "200": {
            "description": "Organizations visible to the current user"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Organization created"
          }
        }
      }
    },
    "/api/v1/tenants": {
      "get": {
        "responses": {
          "200": {
            "description": "Tenant inventory"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Tenant created"
          }
        }
      }
    },
    "/api/v1/policies": {
      "get": {
        "responses": {
          "200": {
            "description": "Policy versions"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Policy draft created"
          }
        }
      }
    },
    "/api/v1/nodes": {
      "get": {
        "summary": "List organization-scoped nodes",
        "description": "Returns node inventory for the authenticated organization. Enrollment tokens and signing credentials are never returned by this endpoint.",
        "responses": {
          "200": {
            "description": "Organization-scoped fleet inventory",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "environment",
                      "region",
                      "status"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "name": {
                        "type": "string"
                      },
                      "environment": {
                        "type": "string"
                      },
                      "region": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "version": {
                        "type": "string"
                      },
                      "last_seen_at": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        }
      },
      "post": {
        "summary": "Register a node",
        "description": "Requires an authenticated organization session, write permission and current x-csrf-token. The response contains a one-time enrollment token; store it securely because list calls never return it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "organization_id",
                  "name"
                ],
                "properties": {
                  "organization_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "environment": {
                    "type": "string",
                    "default": "production"
                  },
                  "region": {
                    "type": "string",
                    "default": "auto"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Node registered; enrollment_token is returned only once",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "status",
                    "enrollment_token"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "const": "pending"
                    },
                    "enrollment_token": {
                      "type": "string",
                      "minLength": 32
                    },
                    "warning": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "402": {
            "description": "Node capacity or entitlement limit reached"
          },
          "403": {
            "description": "Organization mismatch or write permission denied"
          }
        }
      }
    },
    "/api/v1/nodes/{id}/enrollment": {
      "post": {
        "summary": "Mark a registered node as enrolling",
        "description": "Requires an authenticated session, write permission and CSRF token. Updates the organization-owned node status and records an audit event. It does not issue or consume the one-time token.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Enrollment started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "const": "enrolling"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Node not found in the active organization"
          }
        }
      }
    },
    "/api/v1/deployments": {
      "get": {
        "responses": {
          "200": {
            "description": "Deployment history"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Deployment queued"
          }
        }
      }
    },
    "/api/v1/verifications": {
      "get": {
        "responses": {
          "200": {
            "description": "Verification evidence"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Verification evidence recorded"
          }
        }
      }
    },
    "/api/v1/audit": {
      "get": {
        "responses": {
          "200": {
            "description": "Organization audit events"
          }
        }
      }
    },
    "/api/v1/support": {
      "get": {
        "responses": {
          "200": {
            "description": "Support request queue"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Support request created"
          }
        }
      }
    },
    "/api/v1/organization/oidc/entra": {
      "post": {
        "summary": "Configure Microsoft Entra OIDC for the authenticated organization",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tenant_id"
                ],
                "properties": {
                  "tenant_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Customer Microsoft Entra tenant ID."
                  },
                  "jit_provisioning": {
                    "type": "boolean",
                    "default": false,
                    "description": "Allow just-in-time user provisioning into this organization."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Entra connection configured"
          },
          "400": {
            "description": "Invalid Entra tenant ID"
          },
          "403": {
            "description": "Owner/admin role or plan feature required"
          },
          "503": {
            "description": "Client ID or database unavailable"
          }
        }
      },
      "get": {
        "summary": "Get current organization's Microsoft Entra OIDC configuration",
        "responses": {
          "200": {
            "description": "Configured state, tenant ID and JIT provisioning flag; no secret material is returned"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Owner/admin role or plan feature required"
          }
        }
      }
    },
    "/api/v1/auth/oidc/start": {
      "get": {
        "summary": "Start Microsoft Entra OIDC login for an organization",
        "parameters": [
          {
            "name": "organization_slug",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Organization slug shown on the login SSO form."
          },
          {
            "name": "organization_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID-based alternative for controlled administrative/testing workflows."
          }
        ],
        "responses": {
          "200": {
            "description": "Authorization URL to Microsoft Entra ID"
          },
          "400": {
            "description": "Organization slug/ID missing or SSO not configured"
          },
          "503": {
            "description": "OIDC configuration or database unavailable"
          }
        }
      }
    },
    "/api/v1/auth/oidc/callback": {
      "get": {
        "summary": "Handle Microsoft Entra OIDC callback",
        "security": [],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Creates a validated Agata session cookie and redirects to the app"
          },
          "400": {
            "description": "OIDC state, nonce or token validation failed"
          },
          "403": {
            "description": "Entra identity is not linked and JIT provisioning is disabled"
          },
          "503": {
            "description": "Entra token exchange or database unavailable"
          }
        }
      }
    },
    "/api/v1/billing/plans": {
      "get": {
        "summary": "List Agata Proxima plans and checkout availability",
        "responses": {
          "200": {
            "description": "Plan catalog"
          }
        }
      }
    },
    "/api/v1/billing/entitlements": {
      "get": {
        "summary": "Get organization plan entitlements",
        "responses": {
          "200": {
            "description": "Current plan, limits, and enabled features"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/billing": {
      "get": {
        "summary": "Get current organization billing state",
        "responses": {
          "200": {
            "description": "Billing state and current plan"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/billing/checkout": {
      "post": {
        "summary": "Create a Flutterwave checkout for an Agata Proxima monthly plan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "price_id"
                ],
                "properties": {
                  "price_id": {
                    "type": "string",
                    "enum": [
                      "starter",
                      "growth",
                      "scale"
                    ],
                    "description": "Agata Proxima plan key (starter, growth, or scale); the server resolves and validates the configured Flutterwave payment plan ID."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flutterwave hosted checkout URL and local transaction reference",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "provider",
                    "checkout_url",
                    "reference",
                    "amount",
                    "currency"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "provider": {
                      "type": "string",
                      "enum": [
                        "flutterwave"
                      ]
                    },
                    "checkout_url": {
                      "type": "string",
                      "format": "uri",
                      "description": "HTTPS URL returned by Flutterwave for the hosted checkout."
                    },
                    "reference": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Locally stored transaction reference used for server-side verification."
                    },
                    "amount": {
                      "type": "number",
                      "description": "Expected USD amount for the selected plan."
                    },
                    "currency": {
                      "type": "string",
                      "enum": [
                        "USD"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid plan"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Plan is not permitted"
          },
          "503": {
            "description": "Flutterwave is not configured, plan IDs or USD amounts are invalid, or the provider is unavailable."
          }
        }
      }
    },
    "/api/v1/billing/portal": {
      "post": {
        "summary": "Request subscription-management assistance",
        "responses": {
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization administrator required"
          },
          "501": {
            "description": "Subscription-management portal is not implemented"
          }
        },
        "description": "Self-service billing portal is not implemented. Contact Agata Proxima support to manage or cancel a subscription."
      }
    },
    "/api/v1/billing/verify": {
      "get": {
        "summary": "Verify a locally stored Flutterwave transaction",
        "parameters": [
          {
            "name": "reference",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Local checkout reference returned by the checkout endpoint."
          },
          {
            "name": "transaction_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Flutterwave transaction ID returned after hosted checkout."
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction verified against Flutterwave; entitlement state is updated only after server-side verification."
          },
          "400": {
            "description": "Missing or invalid transaction reference/ID"
          },
          "401": {
            "description": "Authentication required"
          },
          "402": {
            "description": "Flutterwave transaction could not be verified"
          },
          "403": {
            "description": "Organization, plan, currency or amount mismatch"
          },
          "404": {
            "description": "Unknown local transaction"
          }
        }
      }
    },
    "/api/v1/production/readiness": {
      "get": {
        "summary": "Report required production configuration checks",
        "security": [],
        "responses": {
          "200": {
            "description": "Readiness status and non-secret configuration check results"
          }
        }
      }
    },
    "/api/v1/developer/api-keys": {
      "get": {
        "summary": "List organization API keys",
        "responses": {
          "200": {
            "description": "Organization API keys"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      },
      "post": {
        "summary": "Create an organization API key",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "API key created; secret material is only returned at creation"
          },
          "401": {
            "description": "Authentication required"
          },
          "402": {
            "description": "Plan key limit reached"
          }
        }
      }
    },
    "/api/v1/developer/api-keys/{id}": {
      "delete": {
        "summary": "Revoke an API key",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "API key revoked"
          },
          "404": {
            "description": "API key not found"
          }
        }
      }
    },
    "/api/v1/developer/webhooks": {
      "get": {
        "summary": "List organization webhooks",
        "responses": {
          "200": {
            "description": "Webhook integrations"
          }
        }
      },
      "post": {
        "summary": "Create a webhook integration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "endpoint_url",
                  "events"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "endpoint_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook integration created"
          },
          "402": {
            "description": "Active integration quota reached"
          }
        }
      }
    },
    "/api/v1/developer/webhooks/{id}": {
      "get": {
        "summary": "Get webhook details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook detail"
          }
        }
      },
      "delete": {
        "summary": "Delete a webhook integration",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook deleted"
          }
        }
      }
    },
    "/api/v1/developer/webhooks/{id}/deliveries": {
      "get": {
        "summary": "List webhook deliveries",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook delivery history"
          }
        }
      }
    },
    "/api/v1/public/support-requests": {
      "post": {
        "summary": "Submit a public support or contact request",
        "description": "Public endpoint. Validates and persists the request before attempting requester confirmation and support-team notification emails. A 202 response includes delivery statuses; it does not guarantee final inbox placement.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "subject",
                  "message"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 200
                  },
                  "message": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 10000
                  },
                  "topic": {
                    "type": "string",
                    "enum": [
                      "general",
                      "documentation",
                      "troubleshooting",
                      "security",
                      "customer",
                      "customers",
                      "developers",
                      "partnerships"
                    ],
                    "default": "general"
                  },
                  "website": {
                    "type": "string",
                    "description": "Hidden honeypot field; leave empty."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request persisted; response includes request ID and email delivery statuses."
          },
          "400": {
            "description": "Invalid request fields."
          },
          "429": {
            "description": "Too many requests for the same email address within the rate-limit window."
          },
          "500": {
            "description": "Persistence failed."
          }
        }
      }
    },
    "/api/v1/developer/webhooks/{id}/deliveries/{delivery_id}/retry": {
      "post": {
        "summary": "Retry or replay a webhook delivery",
        "description": "Queues a previously failed, dead-lettered, or delivered organization-scoped delivery for another attempt. Requires an authenticated write-capable session.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "delivery_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delivery queued"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Insufficient permission"
          },
          "404": {
            "description": "Delivery not found for this organization"
          }
        }
      }
    },
    "/api/v1/developer/webhooks/{id}/rotate-secret": {
      "post": {
        "summary": "Rotate webhook signing secret",
        "description": "Requires organization administrator permission. Returns the new secret once; it is encrypted at rest.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Secret rotated"
          },
          "403": {
            "description": "Administrator permission required"
          },
          "404": {
            "description": "Webhook not found"
          },
          "503": {
            "description": "Webhook encryption key is not configured"
          }
        }
      }
    },
    "/api/v1/developer/webhooks/{id}/enabled": {
      "post": {
        "summary": "Enable or disable a webhook endpoint",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Endpoint state updated"
          },
          "403": {
            "description": "Insufficient permission"
          },
          "404": {
            "description": "Webhook not found"
          }
        }
      }
    },
    "/api/v1/attestations": {
      "get": {
        "summary": "List organization-scoped signed Proxima attestations",
        "description": "Returns the active organization's attestation ledger and reports payload, HMAC signature, and predecessor-chain verification status.",
        "responses": {
          "200": {
            "description": "Attestation records and chain verification status"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      },
      "post": {
        "summary": "Ingest a signed Proxima attestation",
        "description": "Requires a valid authenticated session, write permission, a matching canonical payload, the configured HMAC signing key, and the expected predecessor hash for the node's chain.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "node_id",
                  "attestation_version",
                  "epoch_timestamp_start",
                  "epoch_timestamp_end",
                  "telemetry_summary",
                  "security_state",
                  "previous_block_hash",
                  "canonical_payload",
                  "block_hash",
                  "block_hash_signature"
                ],
                "properties": {
                  "node_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "attestation_version": {
                    "type": "integer",
                    "const": 1
                  },
                  "epoch_timestamp_start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "epoch_timestamp_end": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "telemetry_summary": {
                    "type": "object"
                  },
                  "security_state": {
                    "type": "object"
                  },
                  "previous_block_hash": {
                    "type": "string"
                  },
                  "canonical_payload": {
                    "type": "string",
                    "maxLength": 65536
                  },
                  "block_hash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "block_hash_signature": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed attestation accepted"
          },
          "400": {
            "description": "Invalid attestation fields"
          },
          "409": {
            "description": "Predecessor hash does not match the stored chain"
          },
          "422": {
            "description": "Canonical payload hash, fields, or HMAC signature is invalid"
          },
          "503": {
            "description": "Attestation signing key is not configured"
          }
        }
      }
    },
    "/api/v1/security/events": {
      "post": {
        "summary": "Ingest a Proxima security breaker event",
        "description": "Accepts peer-scoped breaker-trip events from an authenticated operator API key and records them in the organization's audit stream.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "node_id",
                  "event_type",
                  "severity",
                  "peer_fingerprint",
                  "reason",
                  "observed_at"
                ],
                "properties": {
                  "node_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "event_type": {
                    "type": "string",
                    "const": "security.breaker.tripped"
                  },
                  "severity": {
                    "type": "string",
                    "const": "critical"
                  },
                  "peer_fingerprint": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{64}$"
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "observed_at": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Security event recorded in the organization audit stream"
          },
          "400": {
            "description": "Invalid security event envelope"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Operator write permission required"
          }
        }
      }
    },
    "/api/v1/nodes/enroll": {
      "post": {
        "summary": "Bootstrap a registered node identity",
        "description": "Bootstrap endpoint authenticated by the node UUID and one-time enrollment token in the JSON body. The token must be unused, unexpired and belong to the pending node. The Control Plane encrypts the generated node signing key at rest using PROXIMA_NODE_ENROLLMENT_ENCRYPTION_KEY; the Engine must persist the returned key securely.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "node_id",
                  "enrollment_token"
                ],
                "properties": {
                  "node_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "enrollment_token": {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Node identity bootstrapped; signing_key is a one-time 32-byte key encoded as 64 hex characters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "node_id",
                    "organization_id",
                    "name",
                    "status",
                    "signing_key"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "node_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "organization_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "const": "enrolling"
                    },
                    "signing_key": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token invalid, expired, consumed, or node is not pending"
          },
          "503": {
            "description": "Node credential encryption is not configured correctly"
          }
        }
      }
    },
    "/api/v1/nodes/{id}/enrollment-token": {
      "post": {
        "summary": "Rotate an unused node enrollment token",
        "description": "Requires an authenticated session, write permission and CSRF token. Only available for an organization-owned node still pending/enrolling with an unconsumed token and no stored signing credential. The replacement expires after 30 minutes and is returned once.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Replacement one-time token issued; expires after 30 minutes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "status",
                    "enrollment_token"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "const": "pending"
                    },
                    "enrollment_token": {
                      "type": "string"
                    },
                    "warning": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Node does not exist in this organization or is not eligible for token rotation"
          }
        }
      }
    },
    "/api/v1/webhooks/flutterwave": {
      "post": {
        "summary": "Receive Flutterwave webhook events",
        "description": "Validates the configured Flutterwave `verif-hash` header before processing transaction events idempotently. A browser redirect is not proof of payment.",
        "security": [],
        "parameters": [
          {
            "name": "verif-hash",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Configured Flutterwave webhook hash value."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "event_id",
                  "event_type",
                  "data"
                ],
                "properties": {
                  "event_id": {
                    "type": "string"
                  },
                  "event_type": {
                    "type": "string"
                  },
                  "data": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event processed, safely ignored, or recognized as a duplicate"
          },
          "400": {
            "description": "Malformed event or missing transaction reference"
          },
          "401": {
            "description": "Invalid or missing Flutterwave webhook hash"
          },
          "402": {
            "description": "Transaction verification failed"
          },
          "503": {
            "description": "Webhook signing hash or database unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "proxima_session"
      }
    }
  }
}
