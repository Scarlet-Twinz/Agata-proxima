{
  "openapi": "3.1.0",
  "info": {
    "title": "Agata Proxima Control Plane API",
    "version": "0.2.0",
    "description": "Authenticated management plane for organizations, tenants, policies, fleet, deployments, verification, audit and support. The Proxima Engine remains the independent data-plane enforcement authority."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Control plane healthy"
          },
          "503": {
            "description": "Control plane degraded"
          }
        }
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "security": [],
        "responses": {
          "200": {
            "description": "Workspace created and session established"
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "Identity already exists"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "security": [],
        "responses": {
          "200": {
            "description": "Session established"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "responses": {
          "200": {
            "description": "Session revoked"
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "responses": {
          "200": {
            "description": "Current session"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/v1/platform/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Organization platform status"
          }
        }
      }
    },
    "/api/v1/organizations": {
      "get": {
        "responses": {
          "200": {
            "description": "Organizations visible to the current user"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Organization created"
          }
        }
      }
    },
    "/api/v1/tenants": {
      "get": {
        "responses": {
          "200": {
            "description": "Tenant inventory"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Tenant created"
          }
        }
      }
    },
    "/api/v1/policies": {
      "get": {
        "responses": {
          "200": {
            "description": "Policy versions"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Policy draft created"
          }
        }
      }
    },
    "/api/v1/nodes": {
      "get": {
        "responses": {
          "200": {
            "description": "Fleet inventory"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Node registered; one-time enrollment token returned"
          }
        }
      }
    },
    "/api/v1/nodes/{id}/enrollment": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Enrollment started"
          },
          "404": {
            "description": "Node not found"
          }
        }
      }
    },
    "/api/v1/deployments": {
      "get": {
        "responses": {
          "200": {
            "description": "Deployment history"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Deployment queued"
          }
        }
      }
    },
    "/api/v1/verifications": {
      "get": {
        "responses": {
          "200": {
            "description": "Verification evidence"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Verification evidence recorded"
          }
        }
      }
    },
    "/api/v1/audit": {
      "get": {
        "responses": {
          "200": {
            "description": "Organization audit events"
          }
        }
      }
    },
    "/api/v1/support": {
      "get": {
        "responses": {
          "200": {
            "description": "Support request queue"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Support request created"
          }
        }
      }
    },
    "/api/v1/organization/oidc/entra": {
      "post": {
        "summary": "Configure Microsoft Entra OIDC for the current organization",
        "responses": {
          "200": {
            "description": "OIDC connection configured"
          },
          "403": {
            "description": "Plan or role does not permit enterprise SSO"
          }
        }
      }
    },
    "/api/v1/auth/oidc/start": {
      "get": {
        "security": [],
        "parameters": [
          {
            "name": "organization_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorization URL returned"
          }
        }
      }
    },
    "/api/v1/auth/oidc/callback": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "SSO session established"
          },
          "400": {
            "description": "Identity validation failed"
          }
        }
      }
    },
    "/api/v1/billing/plans": {
      "get": {
        "summary": "List Agata Proxima plans and checkout availability",
        "responses": {
          "200": {
            "description": "Plan catalog"
          }
        }
      }
    },
    "/api/v1/billing/entitlements": {
      "get": {
        "summary": "Get organization plan entitlements",
        "responses": {
          "200": {
            "description": "Current plan, limits, and enabled features"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/public/contact": {
      "post": {
        "summary": "Submit a public contact request",
        "description": "Public contact intake. No authenticated session is required.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "category",
                  "subject",
                  "message"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 320
                  },
                  "company": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "general",
                      "sales",
                      "technical",
                      "security",
                      "billing",
                      "partnership",
                      "support"
                    ]
                  },
                  "subject": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 12000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "request_id",
                    "message"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "request_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Request could not be stored"
          }
        }
      }
    },
    "/api/v1/public/support": {
      "post": {
        "summary": "Submit a public support request",
        "description": "Public support intake. No authenticated session is required.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "category",
                  "subject",
                  "message"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 320
                  },
                  "company": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "general",
                      "sales",
                      "technical",
                      "security",
                      "billing",
                      "partnership",
                      "support"
                    ]
                  },
                  "subject": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 12000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "request_id",
                    "message"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "request_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Request could not be stored"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "proxima_session"
      }
    }
  }
}
