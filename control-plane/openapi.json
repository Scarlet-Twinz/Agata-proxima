{
  "openapi": "3.1.0",
  "info": {
    "title": "Agata Proxima Control Plane API",
    "version": "0.3.2",
    "description": "Authenticated management plane for organizations, tenants, policies, fleet, deployments, verification, audit and support. The Proxima Engine remains the independent data-plane enforcement authority."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Control plane healthy"
          },
          "503": {
            "description": "Control plane degraded"
          }
        }
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "security": [],
        "responses": {
          "200": {
            "description": "Workspace created and session established"
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "Identity already exists"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "security": [],
        "responses": {
          "200": {
            "description": "Session established"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "responses": {
          "200": {
            "description": "Session revoked"
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "responses": {
          "200": {
            "description": "Current session"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/v1/platform/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Organization platform status"
          }
        }
      }
    },
    "/api/v1/organizations": {
      "get": {
        "responses": {
          "200": {
            "description": "Organizations visible to the current user"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Organization created"
          }
        }
      }
    },
    "/api/v1/tenants": {
      "get": {
        "responses": {
          "200": {
            "description": "Tenant inventory"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Tenant created"
          }
        }
      }
    },
    "/api/v1/policies": {
      "get": {
        "responses": {
          "200": {
            "description": "Policy versions"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Policy draft created"
          }
        }
      }
    },
    "/api/v1/nodes": {
      "get": {
        "responses": {
          "200": {
            "description": "Fleet inventory"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Node registered; one-time enrollment token returned"
          }
        }
      }
    },
    "/api/v1/nodes/{id}/enrollment": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Enrollment started"
          },
          "404": {
            "description": "Node not found"
          }
        }
      }
    },
    "/api/v1/deployments": {
      "get": {
        "responses": {
          "200": {
            "description": "Deployment history"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Deployment queued"
          }
        }
      }
    },
    "/api/v1/verifications": {
      "get": {
        "responses": {
          "200": {
            "description": "Verification evidence"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Verification evidence recorded"
          }
        }
      }
    },
    "/api/v1/audit": {
      "get": {
        "responses": {
          "200": {
            "description": "Organization audit events"
          }
        }
      }
    },
    "/api/v1/support": {
      "get": {
        "responses": {
          "200": {
            "description": "Support request queue"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Support request created"
          }
        }
      }
    },
    "/api/v1/organization/oidc/entra": {
      "post": {
        "summary": "Configure Microsoft Entra OIDC for the current organization",
        "responses": {
          "200": {
            "description": "OIDC connection configured"
          },
          "403": {
            "description": "Plan or role does not permit enterprise SSO"
          }
        }
      }
    },
    "/api/v1/auth/oidc/start": {
      "get": {
        "security": [],
        "parameters": [
          {
            "name": "organization_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorization URL returned"
          }
        }
      }
    },
    "/api/v1/auth/oidc/callback": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "SSO session established"
          },
          "400": {
            "description": "Identity validation failed"
          }
        }
      }
    },
    "/api/v1/billing/plans": {
      "get": {
        "summary": "List Agata Proxima plans and checkout availability",
        "responses": {
          "200": {
            "description": "Plan catalog"
          }
        }
      }
    },
    "/api/v1/billing/entitlements": {
      "get": {
        "summary": "Get organization plan entitlements",
        "responses": {
          "200": {
            "description": "Current plan, limits, and enabled features"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/integrations": {
      "get": {
        "summary": "List organization integrations"
      },
      "post": {
        "summary": "Create organization integration"
      }
    },
    "/api/v1/integrations/{id}/credentials/rotate": {
      "post": {
        "summary": "Rotate an integration credential",
        "responses": {
          "200": {
            "description": "Rotate an integration credential"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization authorization denied"
          }
        }
      }
    },
    "/api/v1/integrations/{id}/credentials/revoke": {
      "post": {
        "summary": "Revoke an integration credential",
        "responses": {
          "200": {
            "description": "Revoke an integration credential"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization authorization denied"
          }
        }
      }
    },
    "/api/v1/integrations/{id}/deactivate": {
      "post": {
        "summary": "Deactivate an integration",
        "responses": {
          "200": {
            "description": "Deactivate an integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization authorization denied"
          }
        }
      }
    },
    "/api/v1/environments": {
      "get": {
        "summary": "List organization environments"
      },
      "post": {
        "summary": "Create organization environment"
      }
    },
    "/api/v1/environments/{id}/mode": {
      "patch": {
        "summary": "Change environment integration mode",
        "responses": {
          "200": {
            "description": "Change environment integration mode"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization authorization denied"
          }
        }
      }
    },
    "/api/v1/environments/{id}/bypass": {
      "post": {
        "summary": "Authorize explicit time-limited emergency maintenance mode",
        "responses": {
          "200": {
            "description": "Authorize explicit time-limited emergency maintenance mode"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization authorization denied"
          }
        }
      }
    },
    "/api/v1/database-connections": {
      "get": {
        "summary": "List customer database boundaries"
      },
      "post": {
        "summary": "Configure and validate customer database boundary"
      }
    },
    "/api/v1/database-connections/{id}/validate": {
      "post": {
        "summary": "Revalidate an encrypted PostgreSQL connection",
        "responses": {
          "200": {
            "description": "Revalidate an encrypted PostgreSQL connection"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization authorization denied"
          }
        }
      }
    },
    "/api/v1/tenant-context": {
      "post": {
        "summary": "Issue an authenticated tenant context"
      }
    },
    "/api/v1/tenant-context/verify": {
      "post": {
        "summary": "Verify and consume a tenant context through the control plane"
      }
    },
    "/api/v1/tenant-policies": {
      "post": {
        "summary": "Bind a policy to an organization tenant"
      }
    },
    "/api/v1/migrations": {
      "get": {
        "summary": "List migration plans"
      },
      "post": {
        "summary": "Create migration plan"
      }
    },
    "/api/v1/migrations/{id}/preflight": {
      "post": {
        "summary": "Run migration compatibility and readiness preflight",
        "responses": {
          "200": {
            "description": "Run migration compatibility and readiness preflight"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization authorization denied"
          }
        }
      }
    },
    "/api/v1/organization/invitations/{id}/resend": {
      "post": {
        "summary": "Resend a pending organization invitation",
        "responses": {
          "200": {
            "description": "Resend a pending organization invitation"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization authorization denied"
          }
        }
      }
    },
    "/api/v1/organization/invitations/reject": {
      "post": {
        "summary": "Reject an invitation addressed to the authenticated user",
        "responses": {
          "200": {
            "description": "Reject an invitation addressed to the authenticated user"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization authorization denied"
          }
        }
      }
    },
    "/api/v1/organization/team/{member_id}/role": {
      "patch": {
        "summary": "Change a non-owner member role",
        "responses": {
          "200": {
            "description": "Change a non-owner member role"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization authorization denied"
          }
        }
      }
    },
    "/api/v1/organization/team/{member_id}": {
      "delete": {
        "summary": "Remove a non-owner member",
        "responses": {
          "200": {
            "description": "Remove a non-owner member"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization authorization denied"
          }
        }
      }
    },
    "/api/v1/audit/search": {
      "get": {
        "summary": "Search organization audit evidence"
      }
    },
    "/api/v1/integrations/{integration_id}/environments/{environment_id}/credentials/rotate": {
      "post": {
        "summary": "Rotate a credential bound to one environment",
        "responses": {
          "200": {
            "description": "Rotate a credential bound to one environment"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization authorization denied"
          }
        }
      }
    },
    "/api/v1/integrations/{integration_id}/environments/{environment_id}/credentials/revoke": {
      "post": {
        "summary": "Revoke a credential bound to one environment",
        "responses": {
          "200": {
            "description": "Revoke a credential bound to one environment"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization authorization denied"
          }
        }
      }
    },
    "/api/v1/integration-environment-credentials": {
      "get": {
        "summary": "List organization-scoped environment credential metadata without secrets",
        "responses": {
          "200": {
            "description": "Environment credential metadata"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/customer/context": {
      "post": {
        "summary": "Exchange an environment credential for short-lived tenant context"
      }
    },
    "/api/v1/projects": {
      "get": {
        "summary": "List organization projects"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "proxima_session"
      }
    }
  }
}
