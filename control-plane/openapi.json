{
  "openapi": "3.1.0",
  "info": {
    "title": "Agata Proxima Control Plane API",
    "version": "0.2.0",
    "description": "Authenticated management plane for organizations, tenants, policies, fleet, deployments, verification, audit, support and Lemon Squeezy billing. The Proxima Engine remains the independent data-plane enforcement authority."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Control plane healthy"
          },
          "503": {
            "description": "Control plane degraded"
          }
        }
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "security": [],
        "responses": {
          "200": {
            "description": "Workspace created and session established"
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "Identity already exists"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "security": [],
        "responses": {
          "200": {
            "description": "Session established"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "responses": {
          "200": {
            "description": "Session revoked"
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "responses": {
          "200": {
            "description": "Current session"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/v1/platform/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Organization platform status"
          }
        }
      }
    },
    "/api/v1/organizations": {
      "get": {
        "responses": {
          "200": {
            "description": "Organizations visible to the current user"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Organization created"
          }
        }
      }
    },
    "/api/v1/tenants": {
      "get": {
        "responses": {
          "200": {
            "description": "Tenant inventory"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Tenant created"
          }
        }
      }
    },
    "/api/v1/policies": {
      "get": {
        "responses": {
          "200": {
            "description": "Policy versions"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Policy draft created"
          }
        }
      }
    },
    "/api/v1/nodes": {
      "get": {
        "responses": {
          "200": {
            "description": "Fleet inventory"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Node registered; one-time enrollment token returned"
          }
        }
      }
    },
    "/api/v1/nodes/{id}/enrollment": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Enrollment started"
          },
          "404": {
            "description": "Node not found"
          }
        }
      }
    },
    "/api/v1/deployments": {
      "get": {
        "responses": {
          "200": {
            "description": "Deployment history"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Deployment queued"
          }
        }
      }
    },
    "/api/v1/verifications": {
      "get": {
        "responses": {
          "200": {
            "description": "Verification evidence"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Verification evidence recorded"
          }
        }
      }
    },
    "/api/v1/audit": {
      "get": {
        "responses": {
          "200": {
            "description": "Organization audit events"
          }
        }
      }
    },
    "/api/v1/support": {
      "get": {
        "responses": {
          "200": {
            "description": "Support request queue"
          }
        }
      },
      "post": {
        "responses": {
          "200": {
            "description": "Support request created"
          }
        }
      }
    },
    "/api/v1/organization/oidc/entra": {
      "post": {
        "summary": "Configure Microsoft Entra OIDC for the authenticated organization",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tenant_id"
                ],
                "properties": {
                  "tenant_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Customer Microsoft Entra tenant ID."
                  },
                  "jit_provisioning": {
                    "type": "boolean",
                    "default": false,
                    "description": "Allow just-in-time user provisioning into this organization."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Entra connection configured"
          },
          "400": {
            "description": "Invalid Entra tenant ID"
          },
          "403": {
            "description": "Owner/admin role or plan feature required"
          },
          "503": {
            "description": "Client ID or database unavailable"
          }
        }
      },
      "get": {
        "summary": "Get current organization's Microsoft Entra OIDC configuration",
        "responses": {
          "200": {
            "description": "Configured state, tenant ID and JIT provisioning flag; no secret material is returned"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Owner/admin role or plan feature required"
          }
        }
      }
    },
    "/api/v1/auth/oidc/start": {
      "get": {
        "summary": "Start Microsoft Entra OIDC login for an organization",
        "parameters": [
          {
            "name": "organization_slug",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Organization slug shown on the login SSO form."
          },
          {
            "name": "organization_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID-based alternative for controlled administrative/testing workflows."
          }
        ],
        "responses": {
          "200": {
            "description": "Authorization URL to Microsoft Entra ID"
          },
          "400": {
            "description": "Organization slug/ID missing or SSO not configured"
          },
          "503": {
            "description": "OIDC configuration or database unavailable"
          }
        }
      }
    },
    "/api/v1/auth/oidc/callback": {
      "get": {
        "summary": "Handle Microsoft Entra OIDC callback",
        "security": [],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Creates a validated Agata session cookie and redirects to the app"
          },
          "400": {
            "description": "OIDC state, nonce or token validation failed"
          },
          "403": {
            "description": "Entra identity is not linked and JIT provisioning is disabled"
          },
          "503": {
            "description": "Entra token exchange or database unavailable"
          }
        }
      }
    },
    "/api/v1/billing/plans": {
      "get": {
        "summary": "List Agata Proxima plans and checkout availability",
        "responses": {
          "200": {
            "description": "Plan catalog"
          }
        }
      }
    },
    "/api/v1/billing/entitlements": {
      "get": {
        "summary": "Get organization plan entitlements",
        "responses": {
          "200": {
            "description": "Current plan, limits, and enabled features"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/billing": {
      "get": {
        "summary": "Get current organization billing state",
        "responses": {
          "200": {
            "description": "Billing state and current plan"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/billing/checkout": {
      "post": {
        "summary": "Create a Lemon Squeezy checkout for an Agata Proxima monthly plan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "price_id"
                ],
                "properties": {
                  "price_id": {
                    "type": "string",
                    "enum": [
                      "starter",
                      "growth",
                      "scale"
                    ],
                    "description": "Agata Proxima plan key (starter, growth, or scale); the server resolves and validates the configured Lemon Squeezy variant."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lemon Squeezy checkout URL and local checkout reference"
          },
          "400": {
            "description": "Invalid plan"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Plan is not permitted"
          },
          "503": {
            "description": "Lemon Squeezy is not configured, the variant does not match the catalog, or the provider is unavailable"
          }
        }
      }
    },
    "/api/v1/billing/portal": {
      "post": {
        "summary": "Get the Lemon Squeezy customer portal URL",
        "responses": {
          "200": {
            "description": "Lemon Squeezy customer portal URL"
          },
          "400": {
            "description": "No subscription exists"
          },
          "401": {
            "description": "Authentication required"
          },
          "503": {
            "description": "Lemon Squeezy portal URL is not available"
          }
        }
      }
    },
    "/api/v1/billing/verify": {
      "get": {
        "summary": "Check locally stored Lemon Squeezy checkout status",
        "parameters": [
          {
            "name": "reference",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Local transaction status; a paid entitlement is only applied after a verified Lemon Squeezy webhook"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Organization, plan, currency or amount mismatch"
          },
          "404": {
            "description": "Unknown local transaction"
          }
        }
      }
    },
    "/api/v1/production/readiness": {
      "get": {
        "summary": "Report required production configuration checks",
        "security": [],
        "responses": {
          "200": {
            "description": "Readiness status and non-secret configuration check results"
          }
        }
      }
    },
    "/api/v1/developer/api-keys": {
      "get": {
        "summary": "List organization API keys",
        "responses": {
          "200": {
            "description": "Organization API keys"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      },
      "post": {
        "summary": "Create an organization API key",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "API key created; secret material is only returned at creation"
          },
          "401": {
            "description": "Authentication required"
          },
          "402": {
            "description": "Plan key limit reached"
          }
        }
      }
    },
    "/api/v1/developer/api-keys/{id}": {
      "delete": {
        "summary": "Revoke an API key",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "API key revoked"
          },
          "404": {
            "description": "API key not found"
          }
        }
      }
    },
    "/api/v1/developer/webhooks": {
      "get": {
        "summary": "List organization webhooks",
        "responses": {
          "200": {
            "description": "Webhook integrations"
          }
        }
      },
      "post": {
        "summary": "Create a webhook integration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "endpoint_url",
                  "events"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "endpoint_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook integration created"
          },
          "402": {
            "description": "Active integration quota reached"
          }
        }
      }
    },
    "/api/v1/developer/webhooks/{id}": {
      "get": {
        "summary": "Get webhook details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook detail"
          }
        }
      },
      "delete": {
        "summary": "Delete a webhook integration",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook deleted"
          }
        }
      }
    },
    "/api/v1/developer/webhooks/{id}/deliveries": {
      "get": {
        "summary": "List webhook deliveries",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook delivery history"
          }
        }
      }
    },
    "/api/v1/public/support-requests": {
      "post": {
        "summary": "Submit a public support or contact request",
        "description": "Public endpoint. Validates and persists the request before attempting requester confirmation and support-team notification emails. A 202 response includes delivery statuses; it does not guarantee final inbox placement.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "subject",
                  "message"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 200
                  },
                  "message": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 10000
                  },
                  "topic": {
                    "type": "string",
                    "enum": [
                      "general",
                      "documentation",
                      "troubleshooting",
                      "security",
                      "customer",
                      "customers",
                      "developers",
                      "partnerships"
                    ],
                    "default": "general"
                  },
                  "website": {
                    "type": "string",
                    "description": "Hidden honeypot field; leave empty."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request persisted; response includes request ID and email delivery statuses."
          },
          "400": {
            "description": "Invalid request fields."
          },
          "429": {
            "description": "Too many requests for the same email address within the rate-limit window."
          },
          "500": {
            "description": "Persistence failed."
          }
        }
      }
    },
    "/api/v1/billing/lemonsqueezy/callback": {
      "get": {
        "summary": "Lemon Squeezy checkout return",
        "security": [],
        "responses": {
          "200": {
            "description": "Returns to the app; the return URL alone does not confirm payment"
          }
        }
      }
    },
    "/api/v1/webhooks/lemonsqueezy": {
      "post": {
        "summary": "Receive signed Lemon Squeezy webhook events",
        "security": [],
        "parameters": [
          {
            "name": "x-signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "meta",
                  "data"
                ],
                "properties": {
                  "meta": {
                    "type": "object",
                    "required": [
                      "event_name"
                    ],
                    "properties": {
                      "event_name": {
                        "type": "string"
                      },
                      "custom_data": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "additionalProperties": true
                  },
                  "data": {
                    "type": "object",
                    "required": [
                      "id",
                      "attributes"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "attributes": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event processed, safely ignored, or recognized as a duplicate"
          },
          "400": {
            "description": "Malformed event or missing signature"
          },
          "401": {
            "description": "Invalid Lemon Squeezy signature"
          },
          "403": {
            "description": "Store or test/live mode mismatch"
          },
          "503": {
            "description": "Webhook signing secret or database unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "proxima_session"
      }
    }
  }
}
