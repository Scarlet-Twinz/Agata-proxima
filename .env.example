PROXIMA_LISTEN_ADDR=127.0.0.1:6432
PROXIMA_UPSTREAM_ADDR=127.0.0.1:5432

# Minimum 32-byte secret used to authenticate tenant-context tokens.
PROXIMA_TENANT_SIGNING_KEY=
PROXIMA_TENANT_ROLE_PREFIX=proxima_tenant_

# Client-side PostgreSQL TLS termination. PostgreSQL clients use sslmode=require.
PROXIMA_TLS_CERT_FILE=
PROXIMA_TLS_KEY_FILE=
PROXIMA_TLS_REQUIRE_CLIENT=false
PROXIMA_TLS_HANDSHAKE_TIMEOUT_MS=10000

# Upstream PostgreSQL TLS. Production mode is verify-full: CA + hostname verification.
PROXIMA_UPSTREAM_TLS_MODE=disable
PROXIMA_UPSTREAM_TLS_CA_FILE=
PROXIMA_UPSTREAM_TLS_SERVER_NAME=
PROXIMA_UPSTREAM_TLS_HANDSHAKE_TIMEOUT_MS=10000

# Runtime limits.
PROXIMA_MAX_CONNECTIONS=1024
PROXIMA_UPSTREAM_CONNECT_TIMEOUT_MS=10000

# Operator dashboard.
PROXIMA_DASHBOARD_ENABLED=true
PROXIMA_DASHBOARD_LISTEN_ADDR=127.0.0.1:9080

RUST_LOG=proxima_engine=info

## Local development overrides\n# Copy this file to .env.local for machine-specific values and secrets.\n# .env.local is ignored by git and is loaded before .env.\nPROXIMA_CONTROL_DB_HOST_PORT=55443\n\n# Proxima Control Plane (separate management database)
PROXIMA_CONTROL_DATABASE_URL=postgres://proxima_control:proxima-control-dev@127.0.0.1:55443/proxima_control
PROXIMA_CONTROL_BIND=127.0.0.1:8080
PROXIMA_COOKIE_SECURE=false

# Agata Proxima production integrations.
# Set AGATA_PUBLIC_BASE_URL only after the Control Plane has a public HTTPS deployment.
AGATA_PUBLIC_BASE_URL=http://127.0.0.1:8080
PAYSTACK_SECRET_KEY=
AGATA_PAYSTACK_STARTER_PLAN_CODE=
AGATA_PAYSTACK_GROWTH_PLAN_CODE=
AGATA_PAYSTACK_SCALE_PLAN_CODE=
# Paystack webhook signature uses PAYSTACK_SECRET_KEY.

RESEND_API_KEY=
# Set this only after an Agata-owned sending domain has been purchased and verified in Resend.
RESEND_FROM_EMAIL=
PROXIMA_OIDC_ISSUER=
PROXIMA_OIDC_CLIENT_ID=
PROXIMA_OIDC_CLIENT_SECRET=
