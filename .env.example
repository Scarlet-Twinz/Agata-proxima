PROXIMA_LISTEN_ADDR=127.0.0.1:6432
PROXIMA_UPSTREAM_ADDR=127.0.0.1:5432

# Minimum 32-byte secret used to authenticate tenant-context tokens.
PROXIMA_TENANT_SIGNING_KEY=
PROXIMA_TENANT_ROLE_PREFIX=proxima_tenant_

# Client-side PostgreSQL TLS termination. PostgreSQL clients use sslmode=require.
PROXIMA_TLS_CERT_FILE=
PROXIMA_TLS_KEY_FILE=
PROXIMA_TLS_REQUIRE_CLIENT=false
PROXIMA_TLS_HANDSHAKE_TIMEOUT_MS=10000

# Upstream PostgreSQL TLS. Production mode is verify-full: CA + hostname verification.
PROXIMA_UPSTREAM_TLS_MODE=disable
PROXIMA_UPSTREAM_TLS_CA_FILE=
PROXIMA_UPSTREAM_TLS_SERVER_NAME=
PROXIMA_UPSTREAM_TLS_HANDSHAKE_TIMEOUT_MS=10000

# Runtime limits.
PROXIMA_MAX_CONNECTIONS=1024
PROXIMA_UPSTREAM_CONNECT_TIMEOUT_MS=10000

# Operator dashboard.
PROXIMA_DASHBOARD_ENABLED=true
PROXIMA_DASHBOARD_LISTEN_ADDR=127.0.0.1:9080

RUST_LOG=proxima_engine=info

## Local development overrides
# Copy this file to .env.local for machine-specific values and secrets.
# .env.local is ignored by git and is loaded before .env.
PROXIMA_CONTROL_DB_HOST_PORT=55443

# Proxima Control Plane (separate management database)
PROXIMA_CONTROL_DATABASE_URL=postgres://proxima_control:proxima-control-dev@127.0.0.1:55443/proxima_control
PROXIMA_CONTROL_BIND=127.0.0.1:8080
PROXIMA_COOKIE_SECURE=false

# Agata Proxima production integrations.
# Local default only. Set AGATA_PUBLIC_BASE_URL=https://agataproxima.com in the deployed Control Plane.
AGATA_PUBLIC_BASE_URL=http://127.0.0.1:8080
# Lemon Squeezy Test Mode first; never commit real credentials.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_STARTER_VARIANT_ID=
LEMONSQUEEZY_GROWTH_VARIANT_ID=
LEMONSQUEEZY_SCALE_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

RESEND_API_KEY=
# Verified Resend sending domain: agataproxima.com.
RESEND_FROM_EMAIL=
PROXIMA_OIDC_CLIENT_ID=
PROXIMA_OIDC_CLIENT_SECRET=

# Phase 3.23 — purpose-specific Resend sender identities.
# These addresses use the verified agataproxima.com domain.
RESEND_FROM_NO_REPLY_EMAIL="Agata Proxima <no-reply@agataproxima.com>"
RESEND_FROM_SUPPORT_EMAIL="Agata Proxima Support <support@agataproxima.com>"
RESEND_FROM_SECURITY_EMAIL="Agata Proxima Security <security@agataproxima.com>"
RESEND_FROM_BILLING_EMAIL="Agata Proxima Billing <billing@agataproxima.com>"
RESEND_FROM_NOTIFICATIONS_EMAIL="Agata Proxima <notifications@agataproxima.com>"
# Set this to an inbox that the support team can actually read; do not set it to a
# sender-only address unless inbound receiving is configured for that address.
AGATA_SUPPORT_INBOX_EMAIL=

# Published Resend template IDs (resource identifiers, not secrets).
RESEND_TEMPLATE_VERIFY_EMAIL_ID=091dbdb2-21ed-444f-a209-6f44e55d192d
RESEND_TEMPLATE_PASSWORD_RESET_ID=d3c046c7-fef6-42f0-931e-d92b6f96cfdf
RESEND_TEMPLATE_ORGANIZATION_INVITATION_ID=0757a210-a372-4a5a-8fca-e642c2fed3da
RESEND_TEMPLATE_NEW_LOGIN_ALERT_ID=2740537f-79d4-44a1-bbf8-f7913c0be3a0
RESEND_TEMPLATE_SUPPORT_REQUEST_RECEIVED_ID=3ca9fee8-01cd-4d6c-ae75-e0ff7b54034c
RESEND_TEMPLATE_BILLING_UPDATE_ID=0500c270-e1ab-474f-b3d4-288831b73049
