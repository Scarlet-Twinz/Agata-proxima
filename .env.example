PROXIMA_LISTEN_ADDR=127.0.0.1:6432
PROXIMA_UPSTREAM_ADDR=127.0.0.1:5432

# Minimum 32-byte secret used to authenticate tenant-context tokens.
PROXIMA_TENANT_SIGNING_KEY=
PROXIMA_TENANT_ROLE_PREFIX=proxima_tenant_

# Client-side PostgreSQL TLS termination. PostgreSQL clients use sslmode=require.
PROXIMA_TLS_CERT_FILE=
PROXIMA_TLS_KEY_FILE=
PROXIMA_TLS_REQUIRE_CLIENT=false
PROXIMA_TLS_HANDSHAKE_TIMEOUT_MS=10000

# Upstream PostgreSQL TLS. Production mode is verify-full: CA + hostname verification.
PROXIMA_UPSTREAM_TLS_MODE=disable
PROXIMA_UPSTREAM_TLS_CA_FILE=
PROXIMA_UPSTREAM_TLS_SERVER_NAME=
PROXIMA_UPSTREAM_TLS_HANDSHAKE_TIMEOUT_MS=10000

# Runtime limits.
PROXIMA_MAX_CONNECTIONS=1024
PROXIMA_UPSTREAM_CONNECT_TIMEOUT_MS=10000

# Operator dashboard.
PROXIMA_DASHBOARD_ENABLED=true
PROXIMA_DASHBOARD_LISTEN_ADDR=127.0.0.1:9080

RUST_LOG=proxima_engine=info
