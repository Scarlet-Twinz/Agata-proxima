PROXIMA_LISTEN_ADDR=127.0.0.1:6432
PROXIMA_ADMIN_ADDR=127.0.0.1:9080
PROXIMA_UPSTREAM_ADDR=127.0.0.1:5432

# Minimum 32-byte secret used to authenticate tenant-context tokens.
PROXIMA_TENANT_SIGNING_KEY=
PROXIMA_TENANT_ROLE_PREFIX=proxima_tenant_

# Client-facing TLS. Required mode terminates PostgreSQL TLS at Proxima.
PROXIMA_TLS_MODE=disabled
PROXIMA_TLS_CERT_FILE=
PROXIMA_TLS_KEY_FILE=
PROXIMA_TLS_HANDSHAKE_TIMEOUT_MS=10000

# Upstream PostgreSQL TLS. verify-full requires a CA file and DNS/IP server name.
PROXIMA_UPSTREAM_TLS_MODE=disabled
PROXIMA_UPSTREAM_TLS_CA_FILE=
PROXIMA_UPSTREAM_TLS_SERVER_NAME=

# Connection safety.
PROXIMA_MAX_CONNECTIONS=1024
PROXIMA_UPSTREAM_CONNECT_TIMEOUT_MS=10000

RUST_LOG=proxima_engine=info

# TLS termination creates separate client and upstream TLS sessions.
# SCRAM-SHA-256-PLUS channel binding cannot be transparently brokered across
# two different TLS certificates. Clients using this deployment boundary must
# explicitly use channel_binding=disable until Proxima owns the auth exchange.
